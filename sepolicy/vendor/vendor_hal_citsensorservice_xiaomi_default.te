type vendor_hal_citsensorservice_xiaomi_default, domain;
type vendor_hal_citsensorservice_xiaomi_default_exec, exec_type, vendor_file_type, file_type;

# Init daemon setup
init_daemon_domain(vendor_hal_citsensorservice_xiaomi_default)

# Register as a HAL server
hal_server_domain(vendor_hal_citsensorservice_xiaomi_default, vendor_hal_citsensorservice_xiaomi)

# Register AIDL Service
hal_attribute_service(vendor_hal_citsensorservice_xiaomi, vendor_hal_citsensorservice_xiaomi_service)

# Allow binder calls to clients
binder_call(vendor_hal_citsensorservice_xiaomi_default, system_server)
binder_call(vendor_hal_citsensorservice_xiaomi_default, hal_sensors_default)

# Act as a client to other HALs
hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_allocator)
hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_graphics_composer)
hal_client_domain(vendor_hal_citsensorservice_xiaomi_default, hal_mtk_composer_ext)

# HwBinder / ServiceManager access
allow vendor_hal_citsensorservice_xiaomi_default fwk_sensor_service:service_manager find;
allow vendor_hal_citsensorservice_xiaomi_default fwk_sensor_hwservice:hwservice_manager find;

# Properties
set_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_goodix_cct_prop)
set_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_mischeck_prop)
get_prop(vendor_hal_citsensorservice_xiaomi_default, vendor_displayfeature_prop)

# Directory & File access
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:file create_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default mnt_vendor_file:lnk_file r_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default persist_data_file:dir create_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default persist_data_file:file create_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default nvcfg_file:dir create_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default nvcfg_file:file create_file_perms;

r_dir_file(vendor_hal_citsensorservice_xiaomi_default, vendor_displayfeature_sysfs)

# Procfs & Sysfs
allow vendor_hal_citsensorservice_xiaomi_default sysfs_leds:dir search;
allow vendor_hal_citsensorservice_xiaomi_default sysfs_leds:file rw_file_perms;

# Character Devices
allow vendor_hal_citsensorservice_xiaomi_default hf_manager_device:chr_file rw_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_device:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default vendor_displayfeature_device:chr_file rw_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default dri_device:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default dri_device:chr_file rw_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default gpu_device:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default gpu_device:chr_file rw_file_perms;

allow vendor_hal_citsensorservice_xiaomi_default input_device:dir r_dir_perms;
allow vendor_hal_citsensorservice_xiaomi_default input_device:chr_file rw_file_perms;