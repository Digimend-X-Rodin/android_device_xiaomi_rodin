<resources>
    <!-- Bottom margin for keyguard (lockscreen charging info) status indications -->
    <dimen name="keyguard_indication_margin_bottom">165.0dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">415.0dp</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item format="float" name="pixel_pitch" type="dimen">56.95</item>

     <!-- 2. The Music / Now Playing Info (Middle layer) -->
    <!-- Pushes song name/artist above the unlock text -->
    <dimen name="ambient_indication_margin_bottom">185.0dp</dimen>

    <!-- UDFPS animation size and offset -->
    <dimen name="udfps_animation_size">200dp</dimen> <!-- ~556 px -->
    <integer name="udfps_animation_offset">20</integer> <!-- ~55.6 px -->

    <!-- Window blur (shade, lockscreen, bouncer). Stock: 23px -->
    <dimen name="max_window_blur_radius">14px</dimen>
    <!-- Stock: 34dp -->
    <dimen name="max_shade_window_blur_radius">18dp</dimen>
    <dimen name="global_actions_blur_radius">18dp</dimen>
    <!-- Stock: 30dp -->
    <dimen name="bottomsheet_blur_radius">16dp</dimen>
    <!-- Stock: 25dp -->
    <dimen name="notification_background_blur_radius">14dp</dimen>
    <!-- Stock: 23dp -->
    <dimen name="volume_dialog_background_surface_blur_radius">14dp</dimen>
    <!-- Stock: 50dp -->
    <dimen name="dream_overlay_anim_blur_radius">20dp</dimen>
</resources>
