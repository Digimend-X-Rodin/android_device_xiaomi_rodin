diff --git a/touch/aidl/Android.bp b/touch/aidl/Android.bp
new file mode 100644
index 0000000..ea24bf6
--- /dev/null
+++ b/touch/aidl/Android.bp
@@ -0,0 +1,29 @@
+/*
+ * SPDX-FileCopyrightText: 2025 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+aidl_interface {
+    name: "vendor.lineage.touch",
+    vendor_available: true,
+    srcs: ["vendor/lineage/touch/*.aidl"],
+    stability: "vintf",
+    owner: "lineage",
+
+    backend: {
+        cpp: {
+            enabled: false,
+        },
+        java: {
+            sdk_version: "module_current",
+        },
+    },
+    frozen: true,
+    versions_with_info: [
+        {
+            version: "1",
+            imports: [],
+        },
+    ],
+
+}
