+    sk_sp<SkSurface> up[kMaxSurfaces];
+    for (int i = 0; i < filterPasses; i++) {
+        up[i] = p.upTarget(i);
+        if (!up[i]) {
+            return nullptr;
+        }
+    }
+    for (int i = filterPasses - 1; i >= 0; i--) {
+        const sk_sp<SkSurface>& source = (i + 1 == filterPasses) ? p.level(i + 1) : up[i + 1];
+        const float alpha = std::min(1.0f, filterDepth - i);
+        if (alpha < 1.0f) {
