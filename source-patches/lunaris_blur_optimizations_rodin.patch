From 038edd52977cc28abad89a376373024d45d793c1 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Tue, 3 Nov 2026 07:24:14 +0000
Subject: [PATCH 1/7] renderengine: Discard full-coverage Darkmoon passes
 before drawing

KawaseDarkmoon overwrites each pass target with a kSrc draw when alpha is 1,
so the old contents are not needed. Discarding the target first avoids
loading them, which costs DRAM bandwidth on tile-based GPUs.

A pass that is clipped to its content area is left as it was, because pixels
outside the clip keep their contents. The output is unchanged.

Signed-off-by: Omkar Parte <88646966+RAM-UNLOK@users.noreply.github.com>
---
 libs/renderengine/skia/filters/KawaseDarkmoon.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/libs/renderengine/skia/filters/KawaseDarkmoon.cpp b/libs/renderengine/skia/filters/KawaseDarkmoon.cpp
index 30ccaafeb7..7fad6990cc 100644
--- a/libs/renderengine/skia/filters/KawaseDarkmoon.cpp
+++ b/libs/renderengine/skia/filters/KawaseDarkmoon.cpp
@@ -216,7 +216,14 @@ void KawaseDarkmoon::blurInto(const sk_sp<SkSurface>& drawSurface, SkISize drawC
 
     SkCanvas* canvas = drawSurface->getCanvas();
     SkAutoCanvasRestore autoRestore(canvas, true);
-    if (isOversized(drawSurface, drawContent)) {
+    const bool oversized = isOversized(drawSurface, drawContent);
+    if (alpha == 1.0f && !oversized) {
+        // The kSrc draw overwrites every pixel, so the old contents are not needed. Discarding first
+        // avoids loading them, which costs DRAM bandwidth on tile-based GPUs. Not done when the draw is
+        // clipped, since pixels outside the clip keep their contents.
+        canvas->discard();
+    }
+    if (oversized) {
         canvas->clipRect(SkRect::Make(drawContent));
     }
     canvas->drawPaint(paint);
-- 
