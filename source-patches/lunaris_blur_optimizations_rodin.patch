index 279fa59a6a..70643213ff 100644
--- a/libs/renderengine/skia/SkiaRenderEngine.cpp
+++ b/libs/renderengine/skia/SkiaRenderEngine.cpp
@@ -72,6 +72,8 @@
 #include <deque>
 #include <memory>
 #include <numeric>
+#include <cstring>
