From f85f80b8dde29abc5520b0305e1e7134053c7ed3 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Tue, 3 Nov 2026 09:15:08 +0000
Subject: [PATCH 5/7] renderengine: Discard exact-size KawaseDualFilterV2
 passes before drawing

A pass that writes an exact-size target with alpha 1 overwrites every pixel
with a kSrc draw, so the old contents are not needed. Discarding first avoids
loading them, which costs DRAM bandwidth on tile-based GPUs.

Preallocated targets are larger than their content, and the sampler reads the
padding, so they keep their contents. That path is not changed, so the output
is unchanged on every path.

Signed-off-by: Omkar Parte <88646966+RAM-UNLOK@users.noreply.github.com>
---
 .../renderengine/skia/filters/KawaseBlurDualFilterV2.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/libs/renderengine/skia/filters/KawaseBlurDualFilterV2.cpp b/libs/renderengine/skia/filters/KawaseBlurDualFilterV2.cpp
index 660c2a1383..7be60b313d 100644
--- a/libs/renderengine/skia/filters/KawaseBlurDualFilterV2.cpp
+++ b/libs/renderengine/skia/filters/KawaseBlurDualFilterV2.cpp
@@ -191,7 +191,14 @@ void KawaseBlurDualFilterV2::blurInto(const sk_sp<SkSurface>& drawSurface, sk_sp
         paint.setShader(blurBuilder.makeShader(nullptr));
     }
     paint.setBlendMode(alpha == 1.0f ? SkBlendMode::kSrc : SkBlendMode::kSrcOver);
-    drawSurface->getCanvas()->drawPaint(paint);
+    SkCanvas* canvas = drawSurface->getCanvas();
+    if (alpha == 1.0f && !inputEdgesNeedClamp) {
+        // The kSrc draw covers an exact-size target completely, so the old contents are not needed.
+        // inputEdgesNeedClamp is set for preallocated targets, which are larger than their content and
+        // whose padding the sampler reads. Those keep their contents.
+        canvas->discard();
+    }
+    canvas->drawPaint(paint);
 }
 
 sk_sp<SkImage> KawaseBlurDualFilterV2::generateTemporaryImage(SkiaGpuContext* context,
