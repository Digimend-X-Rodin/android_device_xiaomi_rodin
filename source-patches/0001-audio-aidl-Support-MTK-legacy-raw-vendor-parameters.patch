From 39e074f5d0f80aa3844f18cfb4a79d2cde9d9207 Mon Sep 17 00:00:00 2001
From: klozz <carlosj@klozz.dev>
Date: Sat, 26 Sep 2026 02:19:27 -0600
Subject: [PATCH] audio: aidl: Support MTK legacy raw vendor parameters

Some legacy MediaTek audio implementations expect key/value strings to
be forwarded directly through VendorParameter::id.

On affected devices, the legacy parameter parser fails to parse these
parameters with STATUS_UNEXPECTED_NULL, causing vendor parameters such
as in-call volume indices to be dropped.

Add an optional fallback that forwards the original key/value string
when the parser fails with STATUS_UNEXPECTED_NULL.

Keep the workaround behind a Soong configuration option so unaffected
devices continue using the standard AIDL parameter parser path.

This restores in-call volume adjustment on rodin.

Test: make a call and verify that volume up/down correctly adjusts
      the in-call volume.

Change-Id: I6b5f00a7b07db76fd5e1ae7fc37073f14f5f4638
Signed-off-by: klozz <carlosj@klozz.dev>
---
 media/libaudiohal/impl/Android.bp             | 24 +++++++++++++++
 .../libaudiohal/impl/ConversionHelperAidl.cpp | 29 +++++++++++++++++--
 2 files changed, 50 insertions(+), 3 deletions(-)

diff --git a/media/libaudiohal/impl/Android.bp b/media/libaudiohal/impl/Android.bp
index 00f3929bff..8407f5647c 100644
--- a/media/libaudiohal/impl/Android.bp
+++ b/media/libaudiohal/impl/Android.bp
@@ -7,6 +7,29 @@ package {
     default_applicable_licenses: ["frameworks_av_license"],
 }
 
+soong_config_module_type {
+    name: "libaudiohal_mtk_legacy_raw_cc_defaults",
+    module_type: "cc_defaults",
+    config_namespace: "libaudiohal_legacy_raw",
+    bool_variables: [
+        "mtk_legacy_raw_vendor_parameters",
+    ],
+    properties: [
+        "cflags",
+    ],
+}
+
+libaudiohal_mtk_legacy_raw_cc_defaults {
+    name: "libaudiohal_mtk_legacy_raw_defaults",
+    soong_config_variables: {
+        mtk_legacy_raw_vendor_parameters: {
+            cflags: [
+                "-DMTK_LEGACY_RAW_VENDOR_PARAMETERS",
+            ],
+        },
+    },
+}
+
 filegroup {
     name: "audio_core_hal_client_sources",
     srcs: [
@@ -233,6 +256,7 @@ cc_library_shared {
     defaults: [
         "libaudiohal_aidl_default",
         "libaudiohal_default",
+        "libaudiohal_mtk_legacy_raw_defaults",
     ],
     srcs: [
         ":audio_effect_hal_aidl_src_files",
diff --git a/media/libaudiohal/impl/ConversionHelperAidl.cpp b/media/libaudiohal/impl/ConversionHelperAidl.cpp
index 84e0e281ea..393c1f466d 100644
--- a/media/libaudiohal/impl/ConversionHelperAidl.cpp
+++ b/media/libaudiohal/impl/ConversionHelperAidl.cpp
@@ -16,8 +16,9 @@
 
 #define LOG_TAG "ConversionHelperAidl"
 
+#include <android/binder_status.h>
 #include <memory>
-
+#include <utility>
 #include <media/AidlConversionUtil.h>
 #include <utils/Log.h>
 
@@ -77,8 +78,30 @@ status_t fillVendorParameters(std::shared_ptr<IHalAdapterVendorExtension> vendor
     assert(syncParameters.empty() && asyncParameters.empty());
 
     const String8 rawKeysAndValues = parameters.toString();
-    RETURN_STATUS_IF_ERROR(statusTFromBinderStatus(vendorExt->parseVendorParameters(
-            scope, std::string(rawKeysAndValues.c_str()), &syncParameters, &asyncParameters)));
+    auto binderStatus = vendorExt->parseVendorParameters(
+            scope,
+            std::string(rawKeysAndValues.c_str()),
+            &syncParameters,
+            &asyncParameters);
+
+#ifdef MTK_LEGACY_RAW_VENDOR_PARAMETERS
+    if (!binderStatus.isOk() &&
+            binderStatus.getStatus() == STATUS_UNEXPECTED_NULL) {
+        ALOGW("parseVendorParameters returned UNEXPECTED_NULL, "
+              "falling back to raw vendor parameters");
+
+        syncParameters.clear();
+        asyncParameters.clear();
+
+        VendorParameter parameter;
+        parameter.id = rawKeysAndValues.c_str();
+        syncParameters.push_back(std::move(parameter));
+
+        return OK;
+    }
+#endif
+
+    RETURN_STATUS_IF_ERROR(statusTFromBinderStatus(binderStatus));
     return OK;
 }
 
-- 
